# StudyLog 环境变量样例
# 复制为 .env 后按需修改。AI 配置仅在此处维护，前端不提供配置入口。
# 注意：请勿把真实密钥提交到版本库；.env 已被 .gitignore 排除。

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/studylog.db

# 大模型（默认 DeepSeek，OpenAI 兼容协议）
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=20000
# 推理型模型（如 deepseek-flash）会先消耗大量 reasoning tokens，
# 若解析/分析报"输出被截断"，请调大以下预算（默认 4000 / 12000）
AI_MAX_TOKENS_PARSE=4000
AI_MAX_TOKENS_ANALYSIS=12000

LOG_LEVEL=info
LOG_RETAIN_DAYS=14
BACKUP_RETAIN_COUNT=30

TZ=Asia/Shanghai
