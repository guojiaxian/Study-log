{
  "name": "studylog",
  "version": "1.1.0",
  "private": true,
  "description": "StudyLog 初中生学习成绩记录系统（初三 / 2027 中招）",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "build": "npm --prefix web run build",
    "start": "node --disable-warning=ExperimentalWarning server/src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/src/server.js",
    "migrate": "node --disable-warning=ExperimentalWarning server/src/db/migrate.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning server/scripts/seed-demo.js",
    "test": "npm --prefix server test"
  }
}
